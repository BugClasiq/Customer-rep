# Copy to .env and adjust. docker compose reads .env automatically.
# Never commit the real .env.

# Flask
SECRET_KEY=change_me_to_a_long_random_string
JWT_SECRET_KEY=change_me_to_a_long_random_string

# Database (used by both the db service and the backend)
DB_NAME=project_db
DB_USER=project
DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Groq (AI assistant, /api/chat and the Gradio UI)
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

# Port the frontend is published on
FRONTEND_PORT=8080
